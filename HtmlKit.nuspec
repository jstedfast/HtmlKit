<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2011/08/nuspec.xsd">
  <metadata minClientVersion="2.12">
    <id>HtmlKit</id>
    <version>1.3.0</version>
    <title>HtmlKit</title>
    <authors>Jeffrey Stedfast</authors>
    <owners>Jeffrey Stedfast</owners>
    <license type="expression">MIT</license>
    <projectUrl>http://github.com/jstedfast/HtmlKit</projectUrl>
    <repository type="git" url="https://github.com/jstedfast/HtmlKit" />
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>HtmlKit is a cross-platform .NET framework for parsing HTML.</description>
    <summary>HtmlKit is a cross-platform .NET framework for parsing HTML.</summary>
    <releaseNotes>
* Modified HtmlTagId and HtmlAttributeId extensions to be AOT compatible.
* Fixed logic for validating HTML Tag and Attribute names ('&lt;' is a valid tag-name character).
* Added leaveOpen parameters for HtmlWriter .ctors.
* Added nullable attributes.
* Use built-in StringComparer.OrdinalIgnoreCase for netcore and netstandard2.1 - they are faster than the custom OrdinalIgnoreCase implementation used previously (still faster for .NET Framework and netstandard2.0).
* Optimized HtmlTokenizer.ReadAttributeValueQuoted() and ReadPlainText() which improved perf by ~10%.
* Implemented several other optimizations and improvements for AOT.
* Bumped System.Buffers to 4.6.1.
* Bumped System.Memory to 4.6.3.
* Dropped support for net6.0.
* Added support for net10.0.
    </releaseNotes>
    <copyright>Jeffrey Stedfast</copyright>
    <language>en-US</language>
    <tags>html parser</tags>
    <readme>docs\README.md</readme>
    <frameworkAssemblies>
    </frameworkAssemblies>
    <dependencies>
      <group targetFramework="net462">
        <dependency id="System.Buffers" version="4.6.1" />
        <dependency id="System.Memory" version="4.6.3" />
      </group>
      <group targetFramework="net47">
        <dependency id="System.Buffers" version="4.6.1" />
        <dependency id="System.Memory" version="4.6.3" />
      </group>
      <group targetFramework="net48">
        <dependency id="System.Buffers" version="4.6.1" />
        <dependency id="System.Memory" version="4.6.3" />
      </group>
      <group targetFramework="net8.0" />
      <group targetFramework="net10.0" />
      <group targetFramework="netstandard2.0">
        <dependency id="System.Buffers" version="4.6.1" />
        <dependency id="System.Memory" version="4.6.3" />
      </group>
      <group targetFramework="netstandard2.1">
        <dependency id="System.Buffers" version="4.6.1" />
        <dependency id="System.Memory" version="4.6.3" />
      </group>
    </dependencies>
  </metadata>
